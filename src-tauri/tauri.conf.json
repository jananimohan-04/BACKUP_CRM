{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CNCFORGE ERP",
  "version": "1.0.0",
  "identifier": "com.cncforge.erp",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5176 --strictPort",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CNCFORGE ERP",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "maximized": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "CNCFORGE",
    "copyright": "Copyright © 2026 CNCFORGE",
    "shortDescription": "CNCFORGE ERP desktop application",
    "longDescription": "CNCFORGE ERP — enterprise resource planning for CNC machining operations. Windows desktop edition with signed automatic updates.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jananimohan-04/with_cnc/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGN0E0NTI0OUVBRUUxRUQKUldUdDRhNmVKRVY2M3hrWXk2TGp1SjhOT0lDbHhrcXFLOFAyUG5yaWJEUUVjaEwwY2JTaVR6aGgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
